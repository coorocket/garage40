---
import { SITE } from '../data/site';
import { IMAGES } from '../data/images';
import FactCard from './FactCard.astro';
const bg = IMAGES['diagnosis-bg'];
const concerns = [
  '세차 기스·스월마크',
  '광이 줄고 칙칙함',
  '이전 광택 뒤 얼룩·자국',
  '수리·도색 뒤 광택',
  '새 차 보호·유리막코팅',
  '손세차·실내세차',
  '기타 (사진으로 보낼게요)',
];
---
<section class="diagnosis" id="diagnosis" aria-labelledby="diagnosis-title">
  <div class="diagnosis-media" aria-hidden="true"><img src={bg.src} alt={bg.alt} width={bg.width} height={bg.height} loading="lazy" decoding="async" /></div>
  <div class="diagnosis-shade"></div>
  <div class="shell diagnosis-inner">
    <div>
      <p class="eyebrow">사진 2장 도장 진단 · 무료</p>
      <h2 id="diagnosis-title">사진 2장이면 먼저 봐 드립니다.</h2>
      <p class="lead">차 전체 1장, 신경 쓰이는 곳 1장을 보내 주세요. 답장에는 이 세 가지를 적어 드립니다.</p>
      <ol class="numbered">
        <li>광택으로 되는 흠집과 안 되는 흠집</li>
        <li>내 차에 맞는 프로그램</li>
        <li>예상 비용 범위</li>
      </ol>
      <form class="diag-form" data-inquiry aria-label="사진 2장 도장 진단">
        <label>차종 · 연식
          <input type="text" name="car" autocomplete="off" placeholder="예: 그랜저 IG · 2019년식" required aria-required="true" />
        </label>
        <label>가장 신경 쓰이는 부분
          <select name="concern">
            <option value="">선택해 주세요</option>
            {concerns.map((item) => <option>{item}</option>)}
          </select>
        </label>
        <label>원하는 날
          <input type="text" name="when" autocomplete="off" placeholder="예: 이번 주 토요일" />
        </label>
        <div class="diag-actions">
          <a class="btn btn--light" href={`sms:${SITE.phoneTel}`} data-track="form_submit" data-inquiry-sms>문자로 보내기</a>
          <a class="btn btn--kakao" href={SITE.kakao} target="_blank" rel="noopener noreferrer" data-track="form_submit" data-inquiry-kakao>카톡으로 보내기</a>
        </div>
        <p class="diag-status" data-inquiry-status role="status" aria-live="polite"></p>
        <p class="diag-help">적고 누르면 문자 창이 열립니다. 사진 2장만 이어서 붙여 주세요. 적은 내용은 서버로 가지 않습니다.</p>
      </form>
      <p class="diag-tel">전화가 편하시면 <a class="tap" href={`tel:${SITE.phoneTel}`} data-track="bottom_cta">{SITE.phone}</a></p>
    </div>
    <FactCard />
  </div>
</section>
