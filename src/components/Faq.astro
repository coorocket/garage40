---
// 질문·답 목록. 화면 글자와 JSON-LD(FAQPage)가 같은 목록에서 만들어진다.
export interface FaqItem { q: string; a: string; link?: { label: string; href: string } }
interface Props { items: FaqItem[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <div>
      <h3>{item.q}</h3>
      <p>{item.a}</p>
      {item.link && <a class="more" href={item.link.href}>{item.link.label}</a>}
    </div>
  ))}
</div>
