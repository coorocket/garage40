---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { SITE } from '../../data/site';

const path = '/faq/';
const groups = [
  {
    name: '광택',
    items: [
      { q: '광택하면 도장이 얇아지는 거 아닌가요?', a: '광택은 도장 맨 위 투명층을 아주 얇게 다듬어 흠집을 없애는 작업입니다. 그래서 다듬는 양을 줄이는 것이 중요합니다. 폴리시40은 조명 아래에서 흠집 깊이를 먼저 보고, 필요한 만큼만 단계적으로 다듬습니다.' },
      { q: '광택 내도 세차 몇 번 하면 다시 기스 나지 않나요?', a: '다듬어 없앤 흠집은 세차한다고 다시 올라오지 않습니다. 다만 그 뒤에 새로 생기는 흠집까지 막을 수는 없습니다. 모래가 남은 채 문지르는 일만 줄여도 오래 갑니다.' },
      { q: '광택으로 안 지워지는 흠집은 어떤 건가요?', a: '손톱으로 긁었을 때 걸리는 깊은 흠집은 투명층 아래까지 파인 경우가 많아 광택만으로는 없애기 어렵습니다. 사진 2장이면 될지 안 될지 먼저 봐 드립니다.' },
      { q: '광택은 얼마나 자주 해도 되나요?', a: '자주 할수록 좋은 일이 아닙니다. 흠집이 눈에 띄게 쌓였을 때 하고, 그 사이에는 세차 습관과 보호 마감으로 유지하는 편이 도장에 좋습니다.' },
      { q: '새 차에도 광택이 필요한가요?', a: '새 차도 잔흠집이 있을 수 있습니다. 상태를 보고 가볍게 정리하거나, 하지 않아도 된다고 말씀드립니다.' },
    ],
  },
  {
    name: '비용과 예약',
    items: [
      { q: '광택 비용은 얼마인가요?', a: '스탠다드 케어 15만원부터, BEST 정밀 광택 30만원부터, VIP 마스터 리스토어 50만원부터입니다. 차 크기와 도장 상태에 따라 달라집니다.', link: { label: '광택 비용 보기', href: '/polish/price/' } },
      { q: '사진 보고 싸게 말해 놓고, 가면 올리는 거 아닌가요?', a: '사진으로는 예상 범위를 먼저 말씀드립니다. 실제 범위와 비용은 차를 직접 본 뒤, 작업을 시작하기 전에 말씀드리고 협의해서 정합니다.' },
      { q: '차를 얼마나 맡겨야 하나요?', a: '프로그램과 차 상태에 따라 다릅니다. 사진을 보내 주시면 걸리는 시간도 함께 알려 드립니다.' },
      { q: '사진은 어떻게 찍어 보내면 되나요?', a: '차 전체가 보이는 사진 1장, 가장 신경 쓰이는 곳을 가까이서 찍은 사진 1장이면 됩니다. 밝은 곳에서 찍으면 더 정확하게 봐 드릴 수 있습니다.' },
    ],
  },
  {
    name: '그 밖',
    items: [
      { q: '유리막코팅까지 꼭 해야 하나요?', a: '꼭은 아닙니다. 광택은 흠집을 다듬는 일이고, 유리막코팅은 그 위를 보호하는 일입니다. 필요한 경우에만 권합니다.', link: { label: '유리막코팅 보기', href: '/coating/' } },
      { q: '덴트나 판금도색도 하나요?', a: '하지 않습니다. 다른 곳에서 수리·도색한 뒤의 마무리 광택은 합니다.', link: { label: '도색 후 광택 보기', href: '/after-paint/' } },
      { q: '어디에 있나요?', a: `${SITE.address}입니다. 광명·부천·안산·안양·인천에서 가깝습니다.`, link: { label: '오시는 길', href: '/contact/' } },
    ],
  },
];
const faq = groups.flatMap((g) => g.items);
---
<Base path={path} crumbs={[{ name: '자주 묻는 질문', path }]} faq={faq}>
  <div class="page-head sec--ivory">
    <div class="shell"><h1>자동차광택 자주 묻는 질문</h1></div>
  </div>
  <section class="sec sec--ivory">
    <div class="shell">
      {groups.map((group) => (
        <div class="faq-group">
          <h2>{group.name}</h2>
          <Faq items={group.items} />
        </div>
      ))}
    </div>
  </section>
</Base>
